var getSlug = require('../lib/speakingurl');

describe('getSlug with custom replacement', function () {
    'use strict';

    it('should be transliterated', function (done) {

        getSlug('–±—É—É', {
                lang: false,
                custom: {
                    '–±': '–±',
                    '—É': '—É'
                }
            })
            .should.eql('–±—É—É');

        getSlug('[nodejs]', {
                custom: {
                    '[': '[',
                    ']': ']'
                }
            })
            .should.eql('[nodejs]');

        getSlug('[√Ñpfel]', {
                custom: {
                    '[': '[',
                    ']': ']'
                }
            })
            .should.eql('[aepfel]');

        getSlug('[√Ñpfel]', {
                lang: false,
                custom: {
                    '[': '[',
                    ']': ']'
                }
            })
            .should.eql('[aepfel]');

        done();
    });

    it('should be extended with allowed chars', function (done) {

        getSlug('–±—É—É', {
                custom: ['–±', '—É']
            })
            .should.eql('–±—É—É');

        getSlug('[Kn√∂pfe]', {
                custom: ['[', ']']
            })
            .should.eql('[knoepfe]');

        getSlug('[Kn√∂pfe & √ñsen]', {
                custom: ['[', ']']
            })
            .should.eql('[knoepfe-and-oesen]');

        getSlug('[Kn√∂pfe & √ñsen]', {
                custom: ['[', ']'],
                lang: 'de'
            })
            .should.eql('[knoepfe-und-oesen]');

        getSlug('[Kn√∂pfe]', {
                maintainCase: true,
                custom: ['[', ']']
            })
            .should.eql('[Knoepfe]');

        getSlug('[Kn√∂pfe haben L√∂cher]', {
                titleCase: true,
                custom: ['[', ']']
            })
            .should.eql('[Knoepfe-Haben-Loecher]');

        getSlug('[kn√∂pfe haben runde l√∂cher]', {
                titleCase: ['haben', 'runde'],
                custom: ['[', ']']
            })
            .should.eql('[Knoepfe-haben-runde-Loecher]');

        getSlug('[kn√∂pfe haben runde l√∂cher]', {
                titleCase: ['haben', 'runde'],
                maintainCase: true,
                custom: ['[', ']']
            })
            .should.eql('[Knoepfe-haben-runde-Loecher]');

        done();
    });

});°mÕÅ§Øtest-dhivehi.jsÅ°fÇ°c⁄f/* global describe,it */

