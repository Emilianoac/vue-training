                maintainCase: true
            })
            .should.eql('AeOeUeaeoeuess');

        done();
    });

    it('should not replace symbols (de)', function (done) {

        getSlug('√Ñpfel & Birnen', {
                lang: 'de',
                symbols: false
            })
            .should.eql('aepfel-birnen');

        getSlug('√Ñ√ñ√ú√§√∂√º√ü & √Ñpfel', {
