                lang: 'en',
                mark: true,
                maintainCase: true,
                symbols: false
            })
            .should.eql(
                'Sch(*-)ner-(-)Ti-tel-laesst-gruessen!-Bel-ete-!'
            );

        done();
    });

    it('should replace symbols (de)', function (done) {

        getSlug('√Ñpfel & Birnen', {
                lang: 'de'
