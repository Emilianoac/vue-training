                '‚àû': 'asaonasme',
                '‚ô•': 'akhyait',
                '&': 'nhin',
                '|': 'tho',
                '<': 'ngethaw',
                '>': 'kyithaw',
                '‚àë': 'paungld',
                '¬§': 'ngwekye'
            },

            'nl': {
                '‚àÜ': 'delta',
                '‚àû': 'oneindig',
                '‚ô•': 'liefde',
                '&': 'en',
                '|': 'of',
                '<': 'kleiner dan',
                '>': 'groter dan',
                '‚àë': 'som',
                '¬§': 'valuta'
            },

            'it': {
                '‚àÜ': 'delta',
                '‚àû': 'infinito',
                '‚ô•': 'amore',
                '&': 'e',
                '|': 'o',
                '<': 'minore di',
                '>': 'maggiore di',
                '‚àë': 'somma',
                '¬§': 'moneta'
            },

            'pl': {
                '‚àÜ': 'delta',
                '‚àû': 'nieskonczonosc',
                '‚ô•': 'milosc',
                '&': 'i',
                '|': 'lub',
                '<': 'mniejsze niz',
                '>': 'wieksze niz',
                '‚àë': 'suma',
                '¬§': 'waluta'
            },

            'pt': {
                '‚àÜ': 'delta',
                '‚àû': 'infinito',
                '‚ô•': 'amor',
                '&': 'e',
                '|': 'ou',
                '<': 'menor que',
                '>': 'maior que',
                '‚àë': 'soma',
                '¬§': 'moeda'
            },

            'ru': {
