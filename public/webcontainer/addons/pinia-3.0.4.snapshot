                'aaaabbccccddddeeeeeeffgghhchchiiiijjkkllmmnnnnooooppqqrrrrssssttttuuuuuuvvwwxxyyyyzzzz'
            );

        getSlug(
                'Aa√Å√°BbCcƒåƒçDdƒéƒèEe√â√©ƒöƒõFfGgHhChchIi√ç√≠JjKkLlMmNn≈á≈àOo√ì√≥PpQqRr≈ò≈ôSs≈†≈°Tt≈§≈•Uu√ö√∫≈Æ≈ØVvWwXxYy√ù√ΩZz≈Ω≈æ', {
                    lang: 'cs',
                    maintainCase: true
